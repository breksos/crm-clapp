{
  "name": "breksos-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "preview": "vite --port 5174 --strictPort",
    "test": "node --test \"src/**/*.test.ts\"",
    "build": "tauri build --no-bundle",
    "build:web": "tsc --noEmit && vite build",
    "pack": "bash scripts/package.sh && clatch pack pkg",
    "verify": "bash scripts/verify.sh",
    "release:gate": "bash scripts/require-ci-green.sh",
    "release:check": "bash scripts/release-check.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
