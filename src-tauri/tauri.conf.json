{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "crm",
  "version": "0.1.0",
  "identifier": "com.breksos.crm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Breksos CRM",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../assets/icon.png", "icons/icon.ico"]
  }
}
