# Copy to deploy/.env (which git ignores — check: `git check-ignore deploy/.env`).
#
# Generate the password with:   openssl rand -hex 24
# Hex on purpose: it goes into a URL, and base64's / + = would break it.
POSTGRES_PASSWORD=

# Behind a TLS-terminating proxy, set both to 1. Leave 0 to try it on localhost.
CRM_REQUIRE_TLS=0
CRM_TRUST_PROXY=0

# CRM_PORT=8787
